Код макроса
vba
' ========================================
' МАКРОС: Выделение_акций
' Назначение: Удаление эксклюзивных товаров, выделение акций и новинок
' Горячая клавиша: Ctrl+Shift+K (Win) / Cmd+Shift+K (Mac)
' ========================================

Sub Выделение_акций()
    
    Dim i As Long
    Dim lastRow As Long
    Dim valB As String
    Dim valC As Variant
    
    ' Отключаем обновление экрана для скорости
    Application.ScreenUpdating = False
    
    ' Находим последнюю строку в столбце B
    lastRow = Cells(Rows.Count, 2).End(xlUp).Row
    
    ' Проходим по всем строкам
    For i = 1 To lastRow
        valB = LCase(Cells(i, 2).Value)
        valC = Cells(i, 3).Value
        
        ' ===== УСЛОВИЕ 1: Удаляем "Мит Гарден" =====
        ' (эксклюзивный контракт с другим клиентом)
        If InStr(valB, "мит гарден") > 0 Then
            Rows(i).Delete
            GoTo NextRow
        End If
        
        ' ===== УСЛОВИЕ 2: Проверяем исключения в столбце C =====
        ' Если в столбце C пусто — пропускаем (не выделяем)
        If IsEmpty(valC) Or valC = "" Then
            GoTo NextRow
        End If
        
        ' Если в столбце C есть значения 21261016 или 00175 — пропускаем
        If CStr(valC) = "21261016" Or CStr(valC) = "00175" Or CStr(valC) = "175" Then
            GoTo NextRow
        End If
        
        ' ===== УСЛОВИЕ 3: Проверяем "Джавс" =====
        ' (новинки, выделяем зелёным)
        If InStr(valB, "джавс") > 0 Then
            Cells(i, 2).Interior.Color = RGB(144, 238, 144) ' Светло-зелёный
            GoTo NextRow
        End If
        
        ' ===== УСЛОВИЕ 4: Ищем "акция" в столбцах B и C =====
        ' (акционные товары, выделяем жёлтым)
        If InStr(valB, "акция") > 0 Or InStr(LCase(Cells(i, 3).Value), "акция") > 0 Then
            Cells(i, 2).Interior.Color = RGB(255, 255, 0) ' Жёлтый
        End If
        
NextRow:
    Next i
    
    Application.ScreenUpdating = True
    
    ' ===== Сохраняем файл для рассылки клиентам =====
    On Error Resume Next
    ActiveWorkbook.Save
    On Error GoTo 0
    
    MsgBox "Готово! Акции выделены.", vbInformation

End Sub

