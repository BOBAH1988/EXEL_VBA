Код макроса
vba
' ========================================
' МАКРОС: Очистка_Прайса
' Назначение: Автоматическая очистка и подготовка прайс-листов
' Горячая клавиша: Ctrl+Shift+L (Win) / Cmd+Shift+L (Mac)
' ========================================

Sub Очистка_Прайса()

    ' Отключаем обновление экрана и автоматические пересчёты для скорости
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    ' Шаг 1: Удаляем строки с 1 по 10
    Rows("1:10").Delete Shift:=xlUp
    
    ' Шаг 2: Удаляем столбцы D и E
    Columns("D:E").Delete Shift:=xlToLeft

    ' Шаг 3: Сокращаем ширину столбца B на 35%
    Columns("B").ColumnWidth = Columns("B").ColumnWidth * 0.65

    ' Шаг 4: Удаляем строки с пустыми значениями в столбце D (оптимизировано)
    Dim lastRow As Long
    Dim i As Long
    Dim deleteRange As Range
    
    ' Находим последнюю заполненную строку в столбце C (где цены)
    lastRow = Cells(Rows.Count, 3).End(xlUp).Row
    
    ' Собираем все строки для удаления в один диапазон
    For i = 2 To lastRow
        If Cells(i, 4).Value = "" Then  ' Столбец D = 4
            If deleteRange Is Nothing Then
                Set deleteRange = Rows(i)
            Else
                Set deleteRange = Union(deleteRange, Rows(i))
            End If
        End If
    Next i
    
    ' Удаляем все собранные строки за один раз
    If Not deleteRange Is Nothing Then
        deleteRange.Delete
    End If

    ' Шаг 5: Выравниваем столбец D по ширине значений
    Columns("D").AutoFit

    ' Шаг 6: Увеличиваем масштаб листа до 150%
    ActiveWindow.Zoom = 150

    ' Шаг 7: Выравниваем столбец C по правому краю
    Columns("C").HorizontalAlignment = xlRight

    ' Шаг 8: Включаем обратно обновление экрана и автоматические пересчёты
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    
    ' Шаг 9: Возвращаем курсор на ячейку B2
    Range("B2").Select
    
    ' Шаг 10: Сообщение о завершении
    MsgBox "Готово!", vbInformation

End Sub


